{
  "title": "OpenBao Overview (bao-stack)",
  "uid": "bao-overview",
  "tags": ["bao-stack", "openbao"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(up{job=\"openbao\"} == 1)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unsealed Nodes",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(vault_core_unsealed)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Node Present",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(vault_core_active)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request Handling Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "vault_core_handle_request", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active Leases",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "vault_expire_num_leases", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Node Memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=\"openbao\"}", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Audit Log Failures (blocks requests!)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "rate(vault_audit_log_request_failure[5m])", "refId": "A" }]
    }
  ]
}
