#!/usr/bin/env bash
#==============================================================================
# bao-stack configure -- interactive inventory generator
#
# Probes the local network, asks a few questions, and writes config.yml
# (an Ansible inventory describing the desired deployment state).
#
# Usage:
#   ./configure                 # interactive
#   ./configure -i 10.0.0.11,10.0.0.12,10.0.0.13 -m 10.0.0.10  # non-interactive
#==============================================================================
set -euo pipefail

OUTPUT="config.yml"
BAO_NODES=""
INFRA_NODE=""
CLUSTER="main"

usage() {
    cat <<EOF
Usage: ./configure [-i <ip,ip,ip>] [-m <infra-ip>] [-c <cluster-name>] [-o <output>]

  -i   comma-separated OpenBao node IPs (3 or 5 recommended, 1 for a sandbox)
  -m   infra node IP (monitoring, local repo, CA); defaults to the first bao node
  -c   cluster name (default: main)
  -o   output file (default: config.yml)
EOF
    exit 1
}

while getopts "i:m:c:o:h" opt; do
    case "$opt" in
        i) BAO_NODES="$OPTARG" ;;
        m) INFRA_NODE="$OPTARG" ;;
        c) CLUSTER="$OPTARG" ;;
        o) OUTPUT="$OPTARG" ;;
        *) usage ;;
    esac
done

# Detect a sensible default IP for the sandbox case
detect_ip() {
    ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="src") print $(i+1)}' | head -1
}

if [ -z "$BAO_NODES" ]; then
    default_ip="$(detect_ip || true)"
    echo "bao-stack configure"
    echo "==================="
    read -rp "OpenBao node IPs, comma separated [${default_ip:-10.0.0.11}]: " BAO_NODES
    BAO_NODES="${BAO_NODES:-${default_ip:-10.0.0.11}}"
    read -rp "Infra node IP (monitoring/repo/CA) [first bao node]: " INFRA_NODE
    read -rp "Cluster name [main]: " answer
    CLUSTER="${answer:-main}"
fi

IFS=',' read -ra NODES <<< "$BAO_NODES"
INFRA_NODE="${INFRA_NODE:-${NODES[0]}}"

case "${#NODES[@]}" in
    1) echo "NOTE: single-node deployment -- fine for a sandbox, not HA." ;;
    3|5) : ;;
    *) echo "WARNING: ${#NODES[@]} nodes; raft clusters should have 3 or 5 voters." ;;
esac

if [ -e "$OUTPUT" ]; then
    echo "ERROR: $OUTPUT already exists; move it away or use -o." >&2
    exit 1
fi

{
    echo "---"
    echo "# bao-stack inventory -- generated by ./configure on $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# Edit freely: this file is the single source of truth for desired state."
    echo "all:"
    echo "  children:"
    echo ""
    echo "    infra:"
    echo "      hosts:"
    echo "        ${INFRA_NODE}: {}"
    echo ""
    echo "    bao:"
    echo "      children:"
    echo "        bao_${CLUSTER}:"
    echo "          hosts:"
    seq=1
    for node in "${NODES[@]}"; do
        echo "            ${node}: { bao_seq: ${seq} }"
        seq=$((seq + 1))
    done
    cat <<EOF
          vars:
            bao_cluster: ${CLUSTER}
            bao_unseal: shamir                  # shamir | auto (see docs/runbook-unseal.md)
            bao_snapshot_cron: "0 */6 * * *"    # every 6 hours
            bao_snapshot_target: /var/backups/openbao
            bao_tls: internal-ca                # issued by the deployment CA
EOF
} > "$OUTPUT"

echo ""
echo "Wrote ${OUTPUT}:"
echo "  bao nodes : ${BAO_NODES}"
echo "  infra node: ${INFRA_NODE}"
echo ""
echo "Next: ansible-playbook install.yml"
