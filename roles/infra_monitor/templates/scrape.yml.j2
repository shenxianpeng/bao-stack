# VictoriaMetrics scrape configuration (Prometheus-compatible)
global:
  scrape_interval: {{ monitor_scrape_interval }}

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - "{{ host }}:9100"
{% endfor %}

  - job_name: openbao
    metrics_path: /v1/sys/metrics
    params:
      format: [prometheus]
    scheme: https
    tls_config:
      ca_file: {{ ca_home | default('/etc/bao-stack/ca') }}/ca.crt
    # Token-less scrape: bao-stack enables unauthenticated_metrics_access
    # on the listener by default (decision record: docs/lab-notes.md).
    # If you set bao_metrics_unauthenticated: false, add a scoped token here.
    static_configs:
      - targets:
{% for host in groups['bao'] | default([]) %}
          - "{{ host }}:8200"
{% endfor %}
